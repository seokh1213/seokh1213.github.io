    "@types/alpinejs": "^3.13.11",
    "astro": "^7.2.0",
    "astro-font-picker": "^0.2.2",
    "hotkeypad": "^1.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "zod": "^4.3.6"
  },
